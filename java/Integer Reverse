public class First_Java_Program {
	public static int  reversint(int  num)
	{
		int reversed = 0;
	
		
		while (num !=0)
		{
			int digit = num%10;
			
			reversed = reversed *10+digit;
			
			num=num/10;
		}
		return reversed;
	}
	
	
	public static void main(String[]args )
	{
		
		 int result=reversint(1234);
		 
		 System.out.println("reversed :"+result);
	}
	
	}
